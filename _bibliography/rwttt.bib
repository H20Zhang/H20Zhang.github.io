@inproceedings{Arxiv-26-5,
  title              = {{RW-TTT}: Batched Serving for Request-Owned Test-Time Training State},
  author             = {Jian Yang and Zhizhuo Kou and Yao Tian and Hao Zhang and Han Chen and Sirui Han and Yike Guo},
  year               = {2026},
  abstract           = {Test-time training (TTT) adapts an LLM during generation by reading and updating request-owned state, such as fast weights, low-rank deltas, or streaming learner state. This breaks batched LLM serving, which assumes shared static weights: serial execution is correct but slow, while naive batching can corrupt request state. We formulate this problem as read-write TTT serving and present RW-TTT, which tags each decode step with its owner, version, and READ/WRITE effect, batches only compatible phases, and commits updates only to the owner. On one GPU with eight fast-weight In-Place-TTT streams, RW-TTT reaches 274.61 aggregate tok/s, 9.31x over sequential serving and 3.44x over memory-matched independent replicas. It preserves behavior on RULER, a long-context benchmark, and passes owner/version checks.},
  bibtex_show        = {true},
  abbr               = {EMNLP Main},
  booktitle          = {Proceedings of the 2026 Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  pages              = {5328--5338},
  doi                = {10.18653/2026.emnlp-main.232},
  pdf                = {https://aclanthology.org/2026.emnlp-main.232.pdf},
  html               = {https://arxiv.org/html/2605.28053},
  arxiv              = {2605.28053},
  eprint             = {2605.28053},
  archivePrefix      = {arXiv},
  primaryClass       = {cs.LG},
  selected           = {true},
  preview            = {rw-ttt.webp},
}
