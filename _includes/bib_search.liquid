{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <label class="sr-only" for="bibsearch">Search publications</label>
  <i class="fa-solid fa-magnifying-glass publication-search-icon" aria-hidden="true"></i>
  <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Search by title, author, venue, or year…">
{% endif %}
