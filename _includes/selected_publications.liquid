<ul class="featured-papers">
  {% for paper in site.data.selected_publications %}
    {% assign image_path = paper.image | prepend: '/assets/img/publication_preview/' | relative_url %}
    <li class="featured-paper" id="featured-{{ paper.id }}">
      <h3 class="featured-paper-title">
        <span class="featured-paper-venue">{{ paper.venue }}</span>
        <a href="{{ paper.url }}"><strong>{{ paper.short }}</strong>: {{ paper.title }}</a>
      </h3>
      <figure class="featured-paper-figure">
        <img
          src="{{ image_path }}"
          alt="{{ paper.image_alt }}"
          width="{{ paper.width }}"
          height="{{ paper.height }}"
          loading="lazy"
          decoding="async"
          data-zoomable
        >
      </figure>
      <div class="featured-paper-summary">{{ paper.summary | markdownify }}</div>
    </li>
  {% endfor %}
</ul>
