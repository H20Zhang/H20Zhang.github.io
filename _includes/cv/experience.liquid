{% comment %}
  Unified work/experience entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: company, position, start_date, end_date, location, url, summary, highlights
  - JSONResume: name, position, startDate, endDate, location, url, summary, highlights
{% endcomment %}

<ul class="cv-entry-list">
  {% for entry in entries %}
    {% assign start_date = entry.start_date | default: entry.startDate %}
    {% assign end_date = entry.end_date | default: entry.endDate %}
    {% assign start_year = start_date | split: '-' | first %}
    {% assign end_year = end_date | split: '-' | first | default: 'Present' %}
    {% assign position_title = entry.position %}
    {% assign company_name = entry.name | default: entry.company | default: entry.organization %}
    <li class="cv-entry">
      <div class="cv-entry-grid">
        <div class="cv-entry-date">
          {% if start_year %}<span>{{ start_year }} — {{ end_year }}</span>{% endif %}
          {% if entry.location %}<span class="cv-entry-location">{{ entry.location }}</span>{% endif %}
        </div>
        <div class="cv-entry-content">
          {% if entry.url %}
            <p class="cv-entry-title"><a href="{{ entry.url }}">{{ position_title }}</a></p>
          {% elsif position_title %}
            <p class="cv-entry-title">{{ position_title }}</p>
          {% endif %}
          {% if company_name %}<p class="cv-entry-subtitle">{{ company_name }}</p>{% endif %}
          {% if entry.summary %}
            <p class="cv-entry-summary">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          {% endif %}
          {% if entry.highlights %}
            <ul class="cv-entry-highlights">
              {% for item in entry.highlights %}
                <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
