{% assign entry_modifier = '' %}
{% if project.importance == 1 %}
  {% assign entry_modifier = ' system-entry--primary' %}
{% elsif project.importance == 4 %}
  {% assign entry_modifier = ' system-entry--earlier' %}
{% endif %}
  <article class="system-entry{{ entry_modifier }}">
    <a class="system-entry-main" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      <div class="system-entry-heading">
        <h3 class="system-entry-title">{{ project.title }}</h3>
        <span class="system-entry-arrow" aria-hidden="true">→</span>
      </div>
      <p class="system-entry-description">{{ project.description }}</p>
    </a>

    {% if project.github or project.external_url or project.secondary_links %}
      <div class="project-card-actions">
        {% if project.external_url %}
          <a class="github-icon" href="{{ project.external_url }}" target="_blank" rel="noopener noreferrer" title="{{ project.external_label | default: 'External project link' }}">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> {{ project.external_label | default: "Project" }}
          </a>
        {% endif %}
        {% for link in project.secondary_links %}
          <a class="github-icon" href="{{ link.url }}" target="_blank" rel="noopener noreferrer" title="{{ link.label }}">
            <i class="fa-solid fa-chart-line"></i> {{ link.label }}
          </a>
        {% endfor %}
        {% if project.github %}
          <a class="github-icon" href="https://github.com/{{ project.github }}" target="_blank" rel="noopener noreferrer" title="Code Repository">
            <i class="fa-brands fa-github gh-icon"></i> Code
          </a>
          {% if project.github_stars %}
            <span class="stars" data-toggle="tooltip" title="GitHub Stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
  </article>
