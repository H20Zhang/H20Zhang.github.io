<div class="col mb-4">
  <div class="card h-100 hoverable">
    <a class="project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
          </div>
        </div>
      </div>
    </a>
    {% assign research_support = project.research_support %}
    {% unless research_support %}
      {% assign research_support = site.data.system_research[project.title] %}
    {% endunless %}
    {% if research_support %}
      <div class="mx-3 pt-3 pb-1 border-top">
        <div class="small font-weight-bold text-muted mb-2">Research threads</div>
        {% for support in research_support %}
          <div class="small mb-2">
            <strong>{{ support.area }}</strong>:
            {% for paper in support.papers %}
              <a href="{{ paper.url }}">{{ paper.name }}</a> — {{ paper.role }}{% unless forloop.last %}; {% endunless %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {% if project.github or project.external_url or project.secondary_links %}
      <div class="project-card-actions px-3 pb-3">
        {% if project.external_url %}
          <a class="github-icon" href="{{ project.external_url }}" target="_blank" rel="noopener noreferrer" title="{{ project.external_label | default: 'External project link' }}">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> {{ project.external_label | default: "Project" }}
          </a>
        {% endif %}
        {% for link in project.secondary_links %}
          <a class="github-icon ml-3 small" href="{{ link.url }}" target="_blank" rel="noopener noreferrer" title="{{ link.label }}">
            <i class="fa-solid fa-chart-line"></i> {{ link.label }}
          </a>
        {% endfor %}
        {% if project.github %}
          <a class="github-icon" href="https://github.com/{{ project.github }}" target="_blank" rel="noopener noreferrer" title="Code Repository">
            <i class="fa-brands fa-github gh-icon"></i> Code
          </a>
          {% if project.github_stars %}
            <span class="stars" data-toggle="tooltip" title="GitHub Stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
