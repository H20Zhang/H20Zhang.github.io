{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip | strip_newlines %}
{% if site.title == 'blank' %}
  {% capture site_title %}{{ author_name }}{% endcapture %}
{% else %}
  {% capture site_title %}{{ site.title }}{% endcapture %}
{% endif %}

{% capture computed_title %}
  {% if page.seo_title %}
    {{ page.seo_title }}
  {% elsif page.url == '/blog/index.html' %}
    {{ page.title }} | {{ site_title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ site_title }}
    {% else %}
      {{ page.title }} | {{ site_title }}
    {% endif %}
  {% else %}
    {{ site_title }}
  {% endif %}
{% endcapture %}
{% assign computed_title = computed_title | strip | strip_newlines %}
{% assign computed_description = page.description | default: site.description | strip | strip_newlines %}
{% assign computed_keywords = page.keywords | default: site.keywords %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign site_home_url = '/' | absolute_url %}
{% assign website_id = site_home_url | append: '#website' %}
{% assign profile_id = site_home_url | append: '#profile' %}
{% assign person_id = site_home_url | append: '#person' %}
{% assign social_image = page.og_image | default: site.og_image | absolute_url %}
{% assign page_language = page.lang | default: site.lang %}
{% assign page_date_modified = page.last_modified_at | default: page.date %}
{% assign og_locale = 'en_US' %}
{% if page_language == 'zh' %}
  {% assign og_locale = 'zh_CN' %}
{% endif %}
{% capture github_url %}https://github.com/{{ site.data.socials.github_username }}{% endcapture %}
{% assign github_url = github_url | strip %}
{% capture scholar_url %}https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}{% endcapture %}
{% assign scholar_url = scholar_url | strip %}
{% capture linkedin_url %}https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}{% endcapture %}
{% assign linkedin_url = linkedin_url | strip %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ computed_title }}</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ computed_description }}">
{% if computed_keywords %}
  <meta name="keywords" content="{{ computed_keywords }}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.collection == 'posts' %}
  {% assign is_blog_post = true %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ site_title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ computed_title }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ computed_description }}">
  {% if page.og_image or site.og_image %}
    <meta property="og:image" content="{{ social_image }}">
  {% endif %}
  <meta property="og:locale" content="{{ og_locale }}">
  {% if is_blog_post %}
    <meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">
    <meta property="article:modified_time" content="{{ page_date_modified | date_to_xmlschema }}">
    {% for tag in page.tags %}
      <meta property="article:tag" content="{{ tag }}">
    {% endfor %}
  {% endif %}

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ computed_title }}">
  <meta name="twitter:description" content="{{ computed_description }}">
  {% if page.og_image or site.og_image %}
    <meta name="twitter:image" content="{{ social_image }}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if page.lang and page.translation_url %}
  {% assign translation_lang = page.translation_lang %}
  {% unless translation_lang %}
    {% if page.lang == 'zh' %}
      {% assign translation_lang = 'en' %}
    {% elsif page.lang == 'en' %}
      {% assign translation_lang = 'zh' %}
    {% endif %}
  {% endunless %}
  {% if page.lang == 'en' %}
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
  {% elsif translation_lang == 'en' %}
    <link rel="alternate" hreflang="x-default" href="{{ page.translation_url | absolute_url }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": {{ website_id | jsonify }},
          "url": {{ site_home_url | jsonify }},
          "name": {{ author_name | jsonify }},
          "alternateName": "H20Zhang",
          "publisher": { "@id": {{ person_id | jsonify }} }
        },
        {
          "@type": "ProfilePage",
          "@id": {{ profile_id | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "name": {{ computed_title | jsonify }},
          "headline": {{ computed_title | jsonify }},
          "description": {{ computed_description | jsonify }},
          {% if page.last_modified_at %}"dateModified": {{ page.last_modified_at | date_to_xmlschema | jsonify }},{% endif %}
          "isPartOf": { "@id": {{ website_id | jsonify }} },
          "mainEntity": { "@id": {{ person_id | jsonify }} }
        },
        {
          "@type": "Person",
          "@id": {{ person_id | jsonify }},
          "name": {{ author_name | jsonify }},
          "alternateName": ["张颢", "H20Zhang"],
          "url": {{ site_home_url | jsonify }},
          "image": {{ social_image | jsonify }},
          "description": {{ computed_description | jsonify }},
          "jobTitle": "Research Scientist",
          "identifier": {
            "@type": "PropertyValue",
            "propertyID": "ORCID",
            "value": "0000-0002-0026-9283",
            "url": "https://orcid.org/0000-0002-0026-9283"
          },
          "knowsAbout": [
            "Context infrastructure for AI agents",
            "Shared information systems for humans and AI agents",
            "Information retrieval",
            "Vector search",
            "Graph database systems",
            "Hardware-accelerated data systems"
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "ByteDance",
            "url": "https://www.bytedance.com/"
          },
          "alumniOf": [
            {
              "@type": "CollegeOrUniversity",
              "name": "The Chinese University of Hong Kong",
              "url": "https://www.cuhk.edu.hk/"
            },
            {
              "@type": "CollegeOrUniversity",
              "name": "Wuhan University",
              "url": "https://en.whu.edu.cn/"
            }
          ],
          "sameAs": [
            {{ github_url | jsonify }},
            {{ scholar_url | jsonify }},
            {{ linkedin_url | jsonify }}
          ]
        }
      ]
    }
  </script>
  {% elsif is_blog_post %}
    {% assign article_id = canonical_url | append: '#article' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "@id": {{ article_id | jsonify }},
        "url": {{ canonical_url | jsonify }},
        "name": {{ computed_title | jsonify }},
        "headline": {{ computed_title | jsonify }},
        "description": {{ computed_description | jsonify }},
        "datePublished": {{ page.date | date_to_xmlschema | jsonify }},
        "dateModified": {{ page_date_modified | date_to_xmlschema | jsonify }},
        "inLanguage": {{ page_language | jsonify }},
        "image": {{ social_image | jsonify }},
        {% if computed_keywords %}"keywords": {{ computed_keywords | jsonify }},{% endif %}
        {% if page.seo_topics %}
        "about": [
          {% for topic in page.seo_topics %}
          {
            "@type": "Thing",
            "name": {{ topic | jsonify }}
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        {% endif %}
        "mainEntityOfPage": {{ canonical_url | jsonify }},
        "isPartOf": { "@id": {{ website_id | jsonify }} },
        "author": {
          "@type": "Person",
          "@id": {{ person_id | jsonify }},
          "name": {{ author_name | jsonify }},
          "url": {{ site_home_url | jsonify }}
        },
        "publisher": { "@id": {{ person_id | jsonify }} }
      }
    </script>
  {% else %}
    {% assign webpage_id = canonical_url | append: '#webpage' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": {{ webpage_id | jsonify }},
        "url": {{ canonical_url | jsonify }},
        "name": {{ computed_title | jsonify }},
        "headline": {{ computed_title | jsonify }},
        "description": {{ computed_description | jsonify }},
        "isPartOf": { "@id": {{ website_id | jsonify }} },
        "author": { "@id": {{ person_id | jsonify }} }
      }
    </script>
  {% endif %}
{% endif %}
