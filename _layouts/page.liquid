---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.category == 'systems' %}
    {% assign research_support = page.research_support %}
    {% unless research_support %}
      {% assign research_support = site.data.system_research[page.title] %}
    {% endunless %}
    {% if research_support %}
      <h2>Research Threads</h2>
      {% for support in research_support %}
        <div class="mb-3">
          <strong>{{ support.area }}</strong>
          <ul>
            {% for paper in support.papers %}
              <li><a href="{{ paper.url | relative_url }}"><strong>{{ paper.name }}</strong></a> — {{ paper.role }}.</li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    {% endif %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
