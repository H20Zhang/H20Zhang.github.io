@inproceedings{ATC-26,
  title              = {{UBASE}: An AI Search Engine for Trillion-Scale Vector Data Management at {ByteDance}},
  author             = {Yao Tian and Yuncheng Lu and Liyao Xiong and Yuming Xu and Hao Zhang^ and Weichen Zhao and Xi Zhao and Bo Kuang and Dongyu Wang and Jiehui Li and Yakun Li and Lei Zhang},
  year               = {2026},
  abstract           = {Since 2016, UBASE has been the foundation of ByteDance's search infrastructure, scaling to more than 7,000 clusters and 300 PB of indexed data. Driven by the demands of AI workloads, UBASE has evolved from a text search engine into a unified AI search system supporting vector retrieval, lexical matching, and predicate filtering. Its largest deployment indexes nearly one trillion high-dimensional vectors. This scale exposes two central bottlenecks in AI-era retrieval: memory-intensive graph-index construction under sustained ingestion, and the prohibitive cost of keeping vector indexes entirely in memory. UBASE addresses these bottlenecks with two techniques. First, it introduces a quantization-aware vector kernel based on SymRaBitQ, a new symmetric quantization scheme with tight theoretical guarantees that allows index construction to run directly in the quantized space accurately and efficiently without retaining a copy of full-precision vectors. Second, it provides a hybrid storage engine that supports memory-resident, hybrid, and SSD-resident deployments, with fine-grained record-level caching to trade memory for latency under operational control. On large-scale benchmarks, UBASE improves throughput by up to 3x, reduces indexing memory by 80%, and lowers serving cost by up to 99.4% compared with prior systems, while supporting trillion-vector scale, write-heavy or latency-sensitive workloads in production.},
  bibtex_show        = {true},
  abbr               = {ATC},
  booktitle          = {Proceedings of the 2026 ACM SIGOPS Annual Technical Conference (ATC)},
  pages              = {795--810},
  doi                = {10.1145/3828523.3857093},
