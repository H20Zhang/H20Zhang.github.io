{% comment %}
  Unified awards entry renderer for both formats
{% endcomment %}

<ul class="cv-entry-list cv-awards-list">
  {% for entry in entries %}
    {% assign award_year = entry.date | split: '-' | first %}
    <li class="cv-entry">
      <div class="cv-entry-grid">
        <div class="cv-entry-date">{{ award_year }}</div>
        <div class="cv-entry-content">
          {% if entry.url %}
            <p class="cv-entry-title"><a href="{{ entry.url }}">{{ entry.title }}</a></p>
          {% elsif entry.title %}
            <p class="cv-entry-title">{{ entry.title }}</p>
          {% endif %}
          {% if entry.awarder %}<p class="cv-entry-subtitle">{{ entry.awarder }}</p>{% endif %}
          {% if entry.summary %}
            <p class="cv-entry-summary">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
