{% assign news = site.news | sort: "date" | reverse %}
{% assign news_size = news | size %}
{% if include.limit and page.announcements.limit %}
  {% assign news_limit = page.announcements.limit %}
{% else %}
  {% assign news_limit = news_size %}
{% endif %}
<div class="news">
  {% if news_size > 0 %}
    <ol class="news-list" role="list">
      {% for item in news limit: news_limit %}
        {% include news_item.liquid item=item %}
      {% endfor %}
    </ol>
    {% if news_size > news_limit %}
      <details class="news-older">
        <summary><span class="news-older-show">Show older news</span><span class="news-older-hide">Hide older news</span></summary>
        <ol class="news-list" role="list">
          {% for item in news offset: news_limit %}
            {% include news_item.liquid item=item %}
          {% endfor %}
        </ol>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
