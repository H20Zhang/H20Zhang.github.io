---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post{% if page.collection == 'projects' %} post--system-detail{% endif %}">
  <header class="post-header">
    {% if page.collection == 'projects' %}
      <p class="system-page-back"><a href="{{ '/projects/' | relative_url }}">← All systems</a></p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  {% if page.collection == 'projects' %}
    <div class="system-page">
      <div class="system-page-main">
        {% if page.highlights %}
          <dl class="system-highlights">
            {% for item in page.highlights %}
              <div class="system-highlight-card">
                <dt>{{ item.label }}</dt>
                <dd>{{ item.value }}</dd>
              </div>
            {% endfor %}
          </dl>
        {% endif %}
        {% if page.figure %}
          <figure class="system-architecture-figure">
            <img
              src="{{ page.figure.path | relative_url }}"
              alt="{{ page.figure.alt }}"
              loading="eager"
              decoding="async"
              data-zoomable
            >
            {% if page.figure.caption %}
              <figcaption>{{ page.figure.caption }}</figcaption>
            {% endif %}
          </figure>
        {% endif %}
        <article>
          {{ content }}
        </article>
        {% if page.research_support %}
          {% include system_research_details.liquid %}
        {% endif %}
      </div>
      <aside class="system-page-sidebar" aria-label="On this page">
        <div class="system-page-sidebar-label">On this page</div>
        <nav class="system-page-toc">{% toc %}</nav>
        <div class="system-page-sidebar-links">
          {% if page.research_support %}<a href="#research-threads">Research threads</a>{% endif %}
          {% if page.external_url %}<a href="{{ page.external_url }}">{{ page.external_label | default: 'Project site' }} ↗</a>{% endif %}
          {% for link in page.secondary_links %}<a href="{{ link.url }}">{{ link.label }} ↗</a>{% endfor %}
          <a href="{{ '/projects/' | relative_url }}">← All systems</a>
        </div>
      </aside>
    </div>
  {% else %}
    <article>
      {{ content }}
    </article>

    {% if page.research_support %}
      {% include system_research_details.liquid %}
    {% endif %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
