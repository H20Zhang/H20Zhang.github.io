{% if page.research_support %}
<section class="system-research">
  <h2>Research Threads</h2>
  {% for support in page.research_support %}
    <div class="research-thread">
      <div class="research-thread-label">{{ support.area }}</div>
      <div class="research-thread-list">
        {% for paper in support.papers %}
          <details class="research-paper">
            <summary>
              <span class="research-paper-heading">
                <strong>{{ paper.name }}</strong>{% if paper.venue %}<span class="research-paper-venue"> · {{ paper.venue }}</span>{% endif %}
              </span>
            </summary>
            <div class="research-paper-body">
              {% if paper.summary %}<p class="mb-1">{{ paper.summary }}</p>{% endif %}
              <p class="mb-1"><strong>System connection:</strong> {{ paper.role }}</p>
              <div class="research-paper-actions">
                <a href="{{ paper.url | relative_url }}">View publication →</a>{% if paper.code %} · <a href="{{ paper.code }}">Code ↗</a>{% endif %}
              </div>
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</section>
{% endif %}
